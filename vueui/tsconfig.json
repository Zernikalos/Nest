{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "",
    "paths": {
      "@/*": ["./src/*"],
      "@ide-core": ["../ide-core/src/index.ts"],
      "@ide-core/vue": ["../ide-core/src/vue/index.ts"],
      "@ide-core/electron": ["../ide-core/src/electron/index.ts"],
      "@app-settings": ["../nestserver/src/settings/app-settings.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
