{
  "version": "0.2.0",
  "npmClient": "pnpm",
  "packages": [
    "."
  ],
  "command": {
    "version": {
      "allowBranch": [
        "main",
        "master"
      ],
      "conventionalCommits": true,
      "createRelease": false,
      "message": "release: 🚀 %s",
      "push": true,
      "tagVersionPrefix": "v",
      "yes": false
    },
    "exec": {
      "stream": true
    }
  }
}
