{
  "name": "zernikalos-nest",
  "version": "0.1.1",
  "author": "Aarón Negrín <demenus.dev@gmail.com>",
  "description": "Desktop editor for asset management and debugging of Zernikalos Engine",
  "main": "electronapp/dist/main/index.js",
  "license": "MPL-2.0",
  "scripts": {
    "commit": "git-cz",
    "release": "lerna version --conventional-commits --no-push && pnpm run release:finalize",
    "release:prepatch": "lerna version prepatch --conventional-commits --yes --preid alpha --no-push && pnpm run release:finalize",
    "release:preminor": "lerna version preminor --conventional-commits --yes --preid alpha --no-push && pnpm run release:finalize",
    "release:premajor": "lerna version premajor --conventional-commits --yes --preid alpha --no-push && pnpm run release:finalize",
    "release:prerelease": "lerna version prerelease --conventional-commits --yes --preid alpha --no-push && pnpm run release:finalize",
    "release:finalize": "pnpm run sync-root-version && git add package.json && git commit --amend --no-edit",
    "sync-root-version": "node scripts/sync-root-version.js",
    "dev": "node scripts/dev.js",
    "dev:main": "DEBUG=true electron electronapp/dist/main/index.js",
    "dev:ui": "vite --config config/vite/vueui.config.ts",
    "dev:server": "tsc -w -p nestserver/tsconfig.json --preserveWatchOutput",
    "dev:electron:main": "webpack --watch -c config/webpack/electronapp.main.cjs",
    "dev:electron:preload": "vite build --watch -c config/vite/electronapp.preload.config.mjs",
    "build": "node scripts/build.js",
    "build:core": "tsc -p ide-core/tsconfig.json",
    "build:vueui": "vue-tsc -p vueui/tsconfig.json --noEmit && vite build --config config/vite/vueui.config.ts",
    "build:server": "nest build --config config/nest/nestserver-cli.json",
    "build:electron": "pnpm run build:server && webpack -c config/webpack/electronapp.main.cjs && vite build -c config/vite/electronapp.preload.config.mjs",
    "predist": "rimraf out",
    "dist": "node scripts/build-electron.js",
    "dist:mac": "node scripts/build-electron.js mac",
    "dist:win": "node scripts/build-electron.js win",
    "dist:linux": "node scripts/build-electron.js linux",
    "dist:all": "node scripts/build-electron.js all",
    "pack": "node scripts/build-electron.js --dir",
    "clean": "rimraf node_modules dist out"
  },
  "dependencies": {
    "@zernikalos/zernikalos": "latest",
    "@zernikalos/zkbuilder": "latest",
    "@guolao/vue-monaco-editor": "1.6.0",
    "@nestjs/common": "11.1.13",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.13",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/platform-express": "11.1.13",
    "@nestjs/platform-ws": "11.1.13",
    "@nestjs/typeorm": "11.0.0",
    "@nestjs/websockets": "11.1.13",
    "axios": "1.14.0",
    "bootstrap-icons-vue": "1.11.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "rxjs": "7.8.2",
    "crc-32": "1.2.2",
    "strip-ansi": "7.1.2",
    "lodash": "4.17.23",
    "events": "3.3.0",
    "eventemitter3": "5.0.1",
    "get-port": "5.1.1",
    "immer": "10.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-vue-next": "0.460.0",
    "pinia": "2.2.6",
    "radix-vue": "1.9.17",
    "reflect-metadata": "0.2.2",
    "splitpanes": "4.0.4",
    "sqlite3": "5.1.7",
    "tailwind-merge": "3.4.0",
    "typeorm": "0.3.28",
    "vue": "3.5.13",
    "vue-router": "4.5.0",
    "ws": "8.19.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "lerna": "9.0.4",
    "@eslint/js": "9.39.2",
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.13",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.23",
    "@types/node": "25.2.3",
    "@vitejs/plugin-vue": "5.2.1",
    "electron-builder": "26.7.0",
    "electron": "40.4.0",
    "babel-loader": "10.0.0",
    "@babel/preset-env": "7.29.0",
    "eslint": "9.39.2",
    "git-cz": "4.9.0",
    "jest": "30.2.0",
    "jsdom": "28.0.0",
    "rimraf": "6.1.2",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vue-eslint-parser": "10.2.0",
    "webpack": "5.105.2",
    "webpack-cli": "6.0.1",
    "webpack-dev-server": "5.2.3",
    "@types/supertest": "6.0.3",
    "@tailwindcss/vite": "4.1.18",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "chokidar": "4.0.3",
    "vite": "7.3.1",
    "vue-tsc": "2.2.0"
  },
  "workspaces": {
    "packages": [
      "packages/reactui"
    ],
    "nohoist": [
      "**@electron/**"
    ]
  },
  "engines": {
    "node": ">=23",
    "pnpm": ">= 9"
  },
  "pnpm": {
    "dangerouslyAllowAllBuilds": true
  }
}
