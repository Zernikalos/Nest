{
  "name": "zernikalos-nest",
  "version": "0.3.1",
  "author": "Aarón Negrín <demenus.dev@gmail.com>",
  "description": "Desktop editor for asset management and debugging of Zernikalos Engine",
  "main": "electronapp/dist/main/index.js",
  "license": "MPL-2.0",
  "scripts": {
    "commit": "git-cz",
    "release": "lerna version --conventional-commits --no-push",
    "release:prepatch": "lerna version prepatch --conventional-commits --yes --preid alpha --no-push && pnpm run release:finalize",
    "release:preminor": "lerna version preminor --conventional-commits --yes --preid alpha --no-push && pnpm run release:finalize",
    "release:premajor": "lerna version premajor --conventional-commits --yes --preid alpha --no-push && pnpm run release:finalize",
    "release:prerelease": "lerna version prerelease --conventional-commits --yes --preid alpha --no-push && pnpm run release:finalize",
    "release:finalize": "pnpm run sync-root-version && git add package.json && git commit --amend --no-edit",
    "sync-root-version": "node scripts/sync-root-version.js",
    "dev": "node scripts/dev.js",
    "dev:main": "cross-env DEBUG=true electron electronapp/dist/main/index.js",
    "dev:ui": "vite --config vueui/vueui.config.ts",
    "dev:server": "nest build --watch --preserveWatchOutput --config nestserver/nestserver-cli.json",
    "dev:electron:main": "vite build --watch -c electronapp/electronapp.main.config.mjs",
    "dev:electron:preload": "vite build --watch -c electronapp/electronapp.preload.config.mjs",
    "build": "node scripts/build.js",
    "build:core": "tsc -p ide-core/tsconfig.json",
    "build:vueui": "vue-tsc -p vueui/tsconfig.json --noEmit && vite build --config vueui/vueui.config.ts",
    "build:server": "rimraf nestserver/dist && nest build --config nestserver/nestserver-cli.json",
    "build:electron": "vite build -c electronapp/electronapp.main.config.mjs && vite build -c electronapp/electronapp.preload.config.mjs",
    "predist": "rimraf out",
    "dist": "node scripts/build-electron.js",
    "dist:mac": "node scripts/build-electron.js mac",
    "dist:win": "node scripts/build-electron.js win",
    "dist:linux": "node scripts/build-electron.js linux",
    "dist:all": "node scripts/build-electron.js all",
    "pack": "node scripts/build-electron.js --dir",
    "generate:icons": "node scripts/generate-zklogo-ico.cjs",
    "clean": "rimraf node_modules dist out"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "1.6.0",
    "@lucide/vue": "1.31.0",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/mapped-types": "2.1.1",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/platform-ws": "11.1.29",
    "@nestjs/websockets": "11.1.29",
    "@vue/devtools-api": "8.2.1",
    "@vue/runtime-dom": "3.5.41",
    "@vueuse/core": "^14.4.0",
    "@zernikalos/zernikalos": "latest",
    "@zernikalos/zkbuilder": "latest",
    "axios": "1.19.0",
    "bootstrap-icons-vue": "1.11.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "crc-32": "1.2.2",
    "eventemitter3": "5.0.4",
    "get-port": "7.2.0",
    "immer": "11.1.16",
    "lodash": "4.18.1",
    "pinia": "4.0.3",
    "radix-vue": "1.9.17",
    "rxjs": "7.8.2",
    "splitpanes": "4.1.2",
    "tailwind-merge": "3.6.0",
    "vue": "3.5.41",
    "vue-router": "5.2.0",
    "ws": "8.21.3",
    "zod": "4.4.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.29",
    "@tailwindcss/vite": "4.3.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.25",
    "@types/node": "25.6.0",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-vue": "6.0.8",
    "chokidar": "4.0.3",
    "cross-env": "10.1.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "eslint": "10.8.1",
    "git-cz": "4.9.0",
    "jest": "30.4.2",
    "jsdom": "30.0.1",
    "lerna": "10.0.0",
    "png-to-ico": "3.0.2",
    "rimraf": "6.1.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.9"
  },
  "workspaces": {
    "packages": [
      "."
    ],
    "nohoist": [
      "**@electron/**"
    ]
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.1"
  }
}
