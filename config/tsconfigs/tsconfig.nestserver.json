{
  "compilerOptions": {
    "target": "ESNext",
    "module": "commonjs",
    "lib": ["esnext"],
    "rootDir": "../../nestserver/src",
    "outDir": "../../nestserver/dist",
    "baseUrl": "../../nestserver",
    "emitDecoratorMetadata": true,
    "isolatedModules": false,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["../../nestserver/src/**/*"],
  "exclude": ["../../nestserver/node_modules", "../../nestserver/dist", "../../nestserver/**/*spec.ts"]
}
