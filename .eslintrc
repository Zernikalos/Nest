{
  "parser": "@typescript-eslint/parser",
  "plugins": [
    "@typescript-eslint",
    "jest"
  ],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended"
  ],
  "env": {
    "jest/globals": true,
    "browser": true
  },
  "ignorePatterns": ["*.config.js"],
  "rules": {
    "@typescript-eslint/no-namespace": "off",
    "@typescript-eslint/ban-ts-comment": "off"
  },
  "overrides": [
    {
      "files": ["electronapp/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@ide-core/vue",
                "message": "electronapp must not import @ide-core/vue"
              }
            ],
            "patterns": [
              {
                "group": ["**/ide-core/src/**", "../ide-core/src/**", "../../ide-core/src/**"],
                "message": "Import from @ide-core or @ide-core/electron instead of ide-core internal paths"
              }
            ]
          }
        ]
      }
    }
  ]
}
