# Normalize line endings to LF in the repository and working tree on all platforms.
* text=auto eol=lf

# Binary assets - do not modify line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.wasm binary
